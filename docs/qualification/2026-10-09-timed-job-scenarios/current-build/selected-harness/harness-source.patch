+def wait_cancelled(prefix, batch_id, timeout=120):
+    """Await verified task drain without crediting any post-window outcomes."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        summary = cli(prefix, 'batch-status', str(batch_id))
+        if summary.get('done') is True and summary.get('held') == 0 and summary.get('active_commands') == 0:
+            return dict(batch_id=batch_id, done=True, held=0, active_commands=0)
+        time.sleep(0.25)
+    raise TimeoutError('cancelled submission has not positively drained')
+
+
+def cpu_observation(proc=pathlib.Path('/proc')):
+    # Raw cumulative VM CPU ticks allow utilisation deltas without sampling guesses.
+    fields = (proc / 'stat').read_text().splitlines()[0].split()
+    if fields[0] != 'cpu':
+        raise ValueError('missing aggregate CPU counters')
+    return dict(cpu_ticks=[int(value) for value in fields[1:]])
+
+
+def within_window(observed_at, deadline):
+    """Only a complete observation received by the deadline can earn credit."""
+    return observed_at <= deadline
+
+
