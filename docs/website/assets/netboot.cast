{"version": 3, "term": {"cols": 110, "rows": 32}, "timestamp": 1791500770, "idle_time_limit": 2.0, "title": "Reliaburger: three machines netboot into a cluster"}
[0.005, "o", "\u001b[2m# Three machines on one switch (lan0), disks blank, network boot on in their firmware.\u001b[0m\r\n\u001b[2m# The router hands out their addresses. relish adds only the boot part.\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m# os/ holds a lab build of the OS, signed with this run's own key, lab.pem.\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m# From a release, relish image download --dir os fetches it, checked against the release key.\u001b[0m\r\n"]
[1.002, "o", "\u001b[32m\u001b[1m$\u001b[0m "]
