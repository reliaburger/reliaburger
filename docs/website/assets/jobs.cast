[2, "o", "$ relish build burger//burger.toml --registry-port 28114\r\nBuilding burger...\r\n  context: burger/. (18944 bytes, sha256:5add83c6e307d390ad7ed9e3e9750969812ae1383b5a81a14adc9cf7c25eea27)\r\n  context uploaded to Pickle\r\n  destination: pickle://burger:v1\r\n  build:  buildah bud --storage-driver vfs -f Dockerfile --platform linux/amd64,linux/arm64 --manifest localhost:5050/burger:v1 .\r\n  build 1 accepted; waiting (up to 960s)...\r\n  built and pushed burger:v1\r\n\r\n"]
[2.109, "o", "$ relish apply app.toml\r\napplied 3 app(s); the scheduler places them now (watch with `relish status`)\r\n\r\n"]
