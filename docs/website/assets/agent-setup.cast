[2.802, "o", "\u001b[32m\u001b[1m$\u001b[0m ~/rbrec/bin/relish setup --quickstart -o json 2>setup.err >setup.json; echo \"exit $?\"; tail -40 setup.err;\r\n  cat setup.json\r\n"]
[131.402, "o", "\u001b[2mexit 0\u001b[0m\r\n\u001b[2m... download relish\u001b[0m\r\n\u001b[2m[ ok ] install Lima 2.2.1               1.5s  36.6 MiB / 36.6 MiB  23.7 MiB/s\u001b[0m\r\n\u001b[2m[ ok ] download relish                  8.3s  108.6 MiB / 108.6 MiB  13.1 MiB/s\u001b[0m\r\n\u001b[2m[ ok ] download bun                     8.8s  117.0 MiB / 117.0 MiB  13.3 MiB/s\u001b[0m\r\n\u001b[2m[ ok ] download guest image            32.5s  1008.6 MiB / 1008.6 MiB  31.0 MiB/s\u001b[0m\r\n\u001b[2m... boot VM 1\u001b[0m\r\n\u001b[2m... boot VM 2\u001b[0m\r\n\u001b[2m… 116 more lines\u001b[0m\r\n\u001b[2m# that took 2 m 11 s; the recording cut the wait\u001b[0m\r\n"]
[1.357, "o", "\u001b[1mclaude ▸\u001b[0m Cluster is up (three nodes, no warnings). Now checking status and reading the five-minute tour so I\r\n         can walk through it.\r\n"]
[2.243, "o", "\u001b[32m\u001b[1m$\u001b[0m R=~/rbrec/bin/relish; $R status 2>&1 | head -40; curl -s -m 5 http://localhost:18080 | head -5; echo; $R\r\n  agent manual show five-minute-tour --max-bytes 30000 2>&1 | python3 -I -c ' import sys,json\r\n  d=json.loads(sys.stdin.read()) if not d.get(\"ok\"): print(d); sys.exit() x=d[\"data\"] print(x if\r\n  isinstance(x,str) else x.get(\"markdown\") or json.dumps(x)[:20000])'\r\n"]
[1.226, "o", "\u001b[2mcluster: HEALTHY, no problems (rb-19f4696e9bd7-1 answered at 23:36:56 UTC)\u001b[0m\r\n\u001b[2m\u001b[0m\r\n\u001b[2mnodes      3 alive, 0 suspect, 0 dead\u001b[0m\r\n\u001b[2mcouncil    leader rb-19f4696e9bd7-1 (term 1), 3/3 voters, quorum ok, 0 lagging\u001b[0m\r\n\u001b[2mgossip     3 members, last change 15 s ago, 35 updates received\u001b[0m\r\n\u001b[2mversions   bun v0.3.2 on 3 nodes\u001b[0m\r\n\u001b[2mcapacity   cpu 0% allocated (0 of 4 cores), memory 0%\u001b[0m\r\n\u001b[2musage      cpu 2% (busiest rb-19f4696e9bd7-1 4%), memory 19%, disk 30%; newest sample 6 s old\u001b[0m\r\n\u001b[2m… 376 more lines\u001b[0m\r\n"]
[4.72, "m", "Look around"]
[0.0, "o", "\r\n\u001b[1m» Look around\u001b[0m\r\n\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; mkdir -p ~/rbrec/tour && cd ~/rbrec/tour && relish verify 2>&1 | tail -8;\r\n  curl -fsSL https://reliaburger.com/demo/burger.tar.gz -o burger.tar.gz && tar tzf burger.tar.gz | head -30\r\n"]
[3.881, "o", "\u001b[2mverified: every node runs the published bun v0.3.2, byte for byte, signed by a release key\u001b[0m\r\n\u001b[2m\u001b[0m\r\n\u001b[2mNODE             VERSION    PLATFORM        SHA256         HASH       SIGNATURE\u001b[0m\r\n\u001b[2mrb-19f4696e9bd7-2 v0.3.2     linux-aarch64   4219a14b83fd   pass       pass\u001b[0m\r\n\u001b[2mrb-19f4696e9bd7-1 v0.3.2     linux-aarch64   4219a14b83fd   pass       pass\u001b[0m\r\n\u001b[2mrb-19f4696e9bd7-3 v0.3.2     linux-aarch64   4219a14b83fd   pass       pass\u001b[0m\r\n\u001b[2mrelish           v0.3.2     macos-aarch64   e8255e803106   pass       pass\u001b[0m\r\n\u001b[2mburger/\u001b[0m\r\n\u001b[2m… 19 more lines\u001b[0m\r\n"]
[2.21, "o", "\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; T=~/rbrec/tour; tar xzf $T/burger.tar.gz -C $T && cat $T/burger/Dockerfile &&\r\n  relish build $T/burger/burger.toml 2>&1 | tail -8; relish images 2>&1 | tail -5; relish apply\r\n  $T/burger/burger.toml 2>&1 | tail -12\r\n"]
[34.218, "o", "\u001b[2m# Built by `relish build burger.toml` on a cluster node, with Buildah, for\u001b[0m\r\n\u001b[2m# linux/amd64 and linux/arm64.\u001b[0m\r\n\u001b[2m#\u001b[0m\r\n\u001b[2m# The build stage runs on the builder's own architecture ($BUILDPLATFORM) and\u001b[0m\r\n\u001b[2m# cross-compiles for each target ($TARGETARCH). Go does that natively, so\u001b[0m\r\n\u001b[2m# neither platform needs an emulator, and the final stage has no RUN step to\u001b[0m\r\n\u001b[2m# emulate either: it only copies the static binary into Alpine.\u001b[0m\r\n\u001b[2m#\u001b[0m\r\n\u001b[2m… 41 more lines\u001b[0m\r\n\u001b[2m# that took 34 s; the recording cut the wait\u001b[0m\r\n"]
[4.462, "o", "\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; T=~/rbrec/tour; for i in $(seq 1 20); do relish status 2>/dev/null | grep -q\r\n  'instances  10 of 10' && break; perl -e 'select(undef,undef,undef,3)'; done; relish status | sed -n\r\n  '1,3p;9,10p'; relish apps counter | head -8; curl -s -m 10 http://burger.localhost:18080; echo ---batch;\r\n  relish batch submit $T/burger/jobs.toml 2>&1 | tail -3; relish batch watch 1 2>&1 | tail -4; relish jobs\r\n  2>&1 | tail -4; echo ---partition; relish fault partition lettuce --from counter --duration 30s\r\n  --acknowledge 2>&1 | tail -3; curl -s -m 10 http://burger.localhost:18080 | sed -n '1,4p;9,10p'\r\n"]
[88.112, "o", "\u001b[2mcluster: HEALTHY, no problems (rb-19f4696e9bd7-1 answered at 23:39:08 UTC)\u001b[0m\r\n\u001b[2m\u001b[0m\r\n\u001b[2mnodes      3 alive, 0 suspect, 0 dead\u001b[0m\r\n\u001b[2mapps       9: 9 running\u001b[0m\r\n\u001b[2minstances  12 of 12 running\u001b[0m\r\n\u001b[2mNODE                     INSTANCE             APP             NAMESPACE    STATE      PID        RESTARTS A…\u001b[0m\r\n\u001b[2mrb-19f4696e9bd7-1        default__counter-0   counter         default      running    7461       0        1m\u001b[0m\r\n\u001b[2mrb-19f4696e9bd7-2        default__counter-1   counter         default      running    2766       0        1m\u001b[0m\r\n\u001b[2m… 32 more lines\u001b[0m\r\n\u001b[2m# that took 1 m 28 s; the recording cut the wait\u001b[0m\r\n"]
[1.189, "o", "\u001b[1mclaude ▸\u001b[0m Halfway through the tour: burger deployed, batch job ran, lettuce partition worked. Next: rolling\r\n         deploy, auto-rollback, scaling and the agent proposal.\r\n"]
[3.306, "o", "\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; T=~/rbrec/tour; B(){ curl -s -m 10 http://burger.localhost:18080 | perl -pe\r\n  's/\\e\\[[0-9;]*m//g' | cut -c31- | grep -v '^\\s*$'; }; W(){ perl -e \"select(undef,undef,undef,$1)\"; } echo\r\n  ---cheese-v2; relish apply $T/burger/cheese-v2.toml 2>&1 | tail -2; W 25; B | grep cheese echo ---patty-v3;\r\n  relish apply $T/burger/patty-v3.toml 2>&1 | tail -1; W 40; relish apps patty 2>&1 | head -8; relish history\r\n  patty 2>&1 | head -10; B | grep patty echo ---triple; relish apply $T/burger/triple-patty.toml 2>&1 | tail\r\n  -1; W 25; B | grep patty\r\n"]
[90.437, "o", "\u001b[2m---cheese-v2\u001b[0m\r\n\u001b[2m  app cheese: committed to the cluster\u001b[0m\r\n\u001b[2mapplied 1 app(s); the scheduler places them now (watch with `relish apps`)\u001b[0m\r\n\u001b[2m cheese      v2  blue cheese    rb-19f4696e9bd7-1 #043b    3.4 ms\u001b[0m\r\n\u001b[2m cheese      v2  blue cheese    rb-19f4696e9bd7-2 #85a7    3.4 ms\u001b[0m\r\n\u001b[2m---patty-v3\u001b[0m\r\n\u001b[2mapplied 1 app(s); the scheduler places them now (watch with `relish apps`)\u001b[0m\r\n\u001b[2mNODE                     INSTANCE             APP             NAMESPACE    STATE      PID        RESTARTS A…\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m… 12 more lines\u001b[0m\r\n\u001b[2m# that took 1 m 30 s; the recording cut the wait\u001b[0m\r\n"]
[6.271, "o", "\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; T=~/rbrec/tour; B(){ curl -s -m 10 http://burger.localhost:18080 | perl -pe\r\n  's/\\e\\[[0-9;]*m//g' | cut -c31- | grep -v '^\\s*$'; }; W(){ perl -e \"select(undef,undef,undef,$1)\"; } echo\r\n  ---agent; AGENT=$(relish token create --name burger-agent --agent --role deployer --namespaces default --ttl\r\n  1h 2>/dev/null); [ -n \"$AGENT\" ] && echo \"token created (not shown)\" relish agent propose scale patty\r\n  --replicas 2 --reason \"a double is plenty\" --token \"$AGENT\" | cut -c1-900; echo relish proposal approve 1\r\n  --yes 2>&1 | tail -3; W 12; B | grep -c patty; relish undo 1 --yes 2>&1 | tail -3; W 15; B | grep -c patty\r\n  relish token revoke burger-agent 2>&1 | tail -1 echo ---policy; curl -fsSL\r\n  https://raw.githubusercontent.com/reliaburger/reliaburger/v0.3.2/examples/policies/platform.toml -o\r\n  $T/platform.toml && relish policy test -f $T/platform.toml -f $T/burger/burger.toml 2>&1 | head -14 echo\r\n  ---kill; relish fault kill patty --acknowledge 2>&1 | tail -2; W "]
[0.0, "o", "2; B | grep -c patty; W 20; B | grep patty;\r\n"]
[0.0, "o", "  relish timeline --app patty 2>&1 | head -25\r\n"]
[49.658, "o", "\u001b[2m---agent\u001b[0m\r\n\u001b[2mtoken created (not shown)\u001b[0m\r\n\u001b[2m{\"command\":\"propose\",\"data\":{\"dry_run\":false,\"proposal\":{\"apps\":[\"default/patty\"],\"author\":\"burger-agent\",\"…\u001b[0m\r\n\u001b[2m\u001b[0m\r\n\u001b[2m  a double is plenty\u001b[0m\r\n\u001b[2mproposal 1 applied\u001b[0m\r\n\u001b[2mundo: relish undo 1\u001b[0m\r\n\u001b[2m3\u001b[0m\r\n\u001b[2m… 50 more lines\u001b[0m\r\n\u001b[2m# that took 50 s; the recording cut the wait\u001b[0m\r\n"]
[1.978, "o", "\u001b[1mclaude ▸\u001b[0m Nearly done with the tour: proposal/undo, policy test and kill-and-restart all worked. Last part:\r\n         network path, a delay fault, and losing a node (then bringing it back).\r\n"]
[3.113, "o", "\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; W(){ perl -e \"select(undef,undef,undef,$1)\"; } echo ---path; relish path\r\n  counter --to patty 2>&1 | head -22 echo ---metrics; relish metrics counter 2>&1 | head -8 echo ---delay;\r\n  relish fault delay patty 300ms --from counter --duration 30s --acknowledge 2>&1 | tail -1; relish path\r\n  counter --to patty --count 3 2>&1 | grep -i -m6 'degraded\\|delay\\|ms' echo ---node; relish local --help 2>&1\r\n  | sed -n '1,20p'; relish local stop node-3 2>&1 | tail -2; W 75; relish inspect counter 2>&1 | head -10;\r\n  relish wtf --short 2>&1 | head -12\r\n"]
[113.739, "o", "\u001b[2m---path\u001b[0m\r\n\u001b[2mPath default/counter -> default/patty:8080 from node rb-19f4696e9bd7-1\u001b[0m\r\n\u001b[2m  1. DNS query [PASS; observed]\u001b[0m\r\n\u001b[2m     patty.default.internal -> 127.128.19.45 (resolver 192.168.104.4)\u001b[0m\r\n\u001b[2m  2. Service and eBPF state [PASS; observed]\u001b[0m\r\n\u001b[2m     userspace service map: VIP 127.128.19.45, 3 of 3 backends healthy\u001b[0m\r\n\u001b[2m       backend default__patty-0 at 10.191.42.4:8080 (healthy)\u001b[0m\r\n\u001b[2m       backend rb-19f4696e9bd7-3:192.168.104.3:29563:181062fba2e9352032dc4dd6e60380d41c1d91470f67b20ca1dc67…\u001b[0m\r\n\u001b[2m… 68 more lines\u001b[0m\r\n\u001b[2m# that took 1 m 54 s; the recording cut the wait\u001b[0m\r\n"]
[0.829, "o", "\u001b[1mclaude ▸\u001b[0m Bringing node 3 back and doing a final health check.\r\n"]
[2.722, "m", "Install and build (again)"]
[0.0, "o", "\r\n\u001b[1m» Install and build (again)\u001b[0m\r\n\u001b[32m\u001b[1m$\u001b[0m export PATH=~/rbrec/bin:$PATH; relish local start node-3 2>&1 | tail -2; for i in $(seq 1 30); do relish\r\n  status 2>/dev/null | grep -q '3 alive' && relish status | grep -q '3/3 voters' && break; perl -e\r\n  'select(undef,undef,undef,5)'; done; relish status; relish wtf --short 2>&1 | head -8; relish token list\r\n  2>&1 | head; relish local status --name laptop 2>&1 | head -8; curl -s -m 10 http://burger.localhost:18080 |\r\n  perl -pe 's/\\e\\[[0-9;]*m//g' | cut -c31- | grep -v '^\\s*$'; du -sh ~/rbrec 2>/dev/null\r\n"]
[12.177, "o", "\u001b[2mstarted rb-19f4696e9bd7-3\u001b[0m\r\n\u001b[2mcluster: DEGRADED, 1 problem (rb-19f4696e9bd7-1 answered at 23:43:57 UTC)\u001b[0m\r\n\u001b[2m\u001b[0m\r\n\u001b[2mnodes      3 alive, 0 suspect, 0 dead\u001b[0m\r\n\u001b[2mcouncil    leader rb-19f4696e9bd7-1 (term 1), 3/3 voters, quorum ok, 0 lagging\u001b[0m\r\n\u001b[2mgossip     3 members, last change 4 s ago, 292 updates received\u001b[0m\r\n\u001b[2mversions   bun v0.3.2 on 3 nodes\u001b[0m\r\n\u001b[2mcapacity   cpu 8% allocated (0 of 3 cores), memory 4%;               relish nodes --unhealthy\u001b[0m\r\n\u001b[2m… 29 more lines\u001b[0m\r\n\u001b[2m# that took 12 s; the recording cut the wait\u001b[0m\r\n"]
