[1.084, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"active-faults\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"severity\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"warning\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2 Smoker fault(s) are active\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"council-member-down\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"severity\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"warning\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"1 of 3 council members did not answer\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
