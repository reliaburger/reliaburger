[0.341, "o", "\r\n"]
[0.01, "o", "Working with an AI agent\r\nIn brief\r\nA read-only token\r\nThe contract\r\nThe envelope\r\nExit codes\r\nByte budgets\r\nText the cluster didn't write\r\n"]
[0.0, "o", "\r\n"]
[1.085, "o", "\u001b[2m# resources (3 nodes): bun 296.6 MiB, 8.2 % CPU · nodes 1362.6 MiB, 14.4 % CPU · network 62.9 in, 63.8 out KiB/s\u001b[0m\r\n"]
[0.061, "o", "\u001b[2m# Resource use: 64 samples over 315 s on 3 nodes, added together\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#                      average           peak\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   bun CPU                6.2 %         13.4 %\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   bun memory           379.3 MiB      413.2 MiB\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   node CPU              26.9 %        155.4 %\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   node memory         1612.7 MiB     1783.9 MiB\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   network in           457.7 KiB/s  14804.0 KiB/s\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   network out          198.0 KiB/s   3013.0 KiB/s\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   CPU is a percentage of one core.\u001b[0m\r\n"]
[0.007, "o", "\r\n"]
[0.0, "o", "\u001b[2m# That's the tour. `relish local destroy --yes` removes the cluster,\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# and `relish uninstall` removes relish itself.\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# New in 0.3.0: the same cluster on real machines. `sudo relish netboot` installs our\u001b[0m\r\n\u001b[2m# appliance OS on them over the network; https://reliaburger.com/#netboot shows how.\u001b[0m\r\n"]
[2.012, "x", "0"]
