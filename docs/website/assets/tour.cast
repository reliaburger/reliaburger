[0.0, "o", "\u001b[2m#   CPU is a percentage of one core.\u001b[0m\r\n"]
[0.004, "o", "\r\n"]
[0.0, "o", "\u001b[2m# That's the tour. `relish local destroy --yes` removes the cluster,\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# and `relish uninstall` removes relish itself.\u001b[0m\r\n"]
