{"version": 3, "term": {"cols": 110, "rows": 32}, "timestamp": 1793696050, "idle_time_limit": 2.0, "title": "Reliaburger 0.2.5: the five-minute tour"}
[0.017, "o", "\u001b[2m# The five-minute tour from reliaburger.com, on a real three-node laptop cluster,\u001b[0m\r\n"]
[0.001, "o", "\u001b[2m# run by scripts/demo/tour.sh. It waits on the cluster's real state where the tour\u001b[0m\r\n\u001b[2m# says to wait, and says how long each wait took.\u001b[0m\r\n\u001b[2m# This recording cuts idle time to 2 s, so those numbers are the real ones.\u001b[0m\r\n\r\n"]
[1.014, "m", "Install"]
[0.0, "o", "\u001b[1m» Install\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# Step 1 installs the published v0.2.5 release, then runs\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# `relish setup --quickstart`. The times on the right are real.\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# This step plays 4× faster than it ran.\u001b[0m\r\n"]
[0.0, "o", "\u001b[32m\u001b[1m$\u001b[0m "]
