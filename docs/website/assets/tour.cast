[0.008, "o", "Working with an AI agent\r\nIn brief\r\nA read-only token\r\nThe contract\r\nThe envelope\r\nExit codes\r\nByte budgets\r\nText the cluster didn't write\r\n"]
[0.0, "o", "\r\n"]
[1.061, "o", "\u001b[2m# resources (3 nodes): bun 301.8 MiB, 5.8 % CPU · nodes 1386.3 MiB, 10.6 % CPU · network 59.5 in, 59.5 out KiB/s\u001b[0m\r\n"]
[0.058, "o", "\u001b[2m# Resource use: 72 samples over 355 s on 3 nodes, added together\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#                      average           peak\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   bun CPU                6.3 %         19.8 %\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   bun memory           367.5 MiB      414.3 MiB\u001b[0m\r\n\u001b[2m#   node CPU              25.7 %        194.6 %\u001b[0m\r\n\u001b[2m#   node memory         1584.3 MiB     1781.0 MiB\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   network in           411.6 KiB/s  14804.3 KiB/s\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   network out          181.1 KiB/s   3053.5 KiB/s\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   CPU is a percentage of one core.\u001b[0m\r\n"]
[0.006, "o", "\r\n"]
[0.0, "o", "\u001b[2m# That's the tour. `relish local destroy --yes` removes the cluster,\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# and `relish uninstall` removes relish itself.\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# New in 0.3.0: the same cluster on real machines. `sudo relish netboot` installs our\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# appliance OS on them over the network; https://reliaburger.com/#netboot shows how.\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m# New in 0.3.1: `relish tui` searches logs and metrics with /, and k kills an instance.\u001b[0m\r\n"]
[2.007, "x", "0"]
