[0.0, "o", "\u001b[2m#   node CPU              29.4 %        190.0 %\u001b[0m\r\n"]
[0.0, "o", "\u001b[2m#   node memory         1048.7 MiB     1178.2 MiB\u001b[0m\r\n"]
