[0.011, "o", "Working with an AI agent\r\nIn brief\r\nA read-only token\r\nThe contract\r\nThe envelope\r\nExit codes\r\nByte budgets\r\nText the cluster didn't write\r\n"]
[0.001, "o", "\r\n"]
[1.073, "o", "\u001b[2m# resources (3 nodes): bun 262.0 MiB, 8.0 % CPU · nodes 893.7 MiB, 16.2 % CPU · network 49.0 in, 49.8 out KiB/s\u001b[0m\r\n"]
[0.052, "o", "\u001b[2m# Resource use: 55 samples over 270 s on 3 nodes, added together\u001b[0m\r\n"]
