# Install /etc/reliaburger from a seed: a tarball of node.toml, master.key,
# identity/ and, on the first node, security-bootstrap.json. It comes from
# the reliaburger.seed credential (the lab passes it with QEMU's
# -smbios type=11) or from a USB stick labelled RBSEED (real machines,
# research §4.2's seed mode). It runs while node.toml is absent; without a
# seed, bun runs standalone. The claim flow replaces this in Phase 2.
[Unit]
Description=Reliaburger seed
Before=reliaburger.service
ConditionPathExists=!/etc/reliaburger/node.toml

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=reliaburger.seed
StandardOutput=journal+console
ExecStart=/usr/lib/reliaburger/apply-seed

[Install]
WantedBy=multi-user.target
