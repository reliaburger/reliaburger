# Prepare this node from its seed before the agent starts: install the
# bootstrap material of the node that creates the cluster, or enrol with a
# join token and fetch the master key (`bun appliance prepare`). The seed is
# the reliaburger.seed credential or seeds/<mac>.seed on a USB stick labelled
# RBSEED. Without one, bun runs standalone. Claiming over the LAN (W5)
# replaces seeds for most fleets.
[Unit]
Description=Reliaburger seed
After=network-online.target
Wants=network-online.target
Before=reliaburger.service
ConditionPathExists=!/etc/reliaburger/node.toml

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=reliaburger.seed
# A joiner waits for its first member to come up, which can take a while
# when a whole fleet powers on together.
TimeoutStartSec=infinity
StandardOutput=journal+console
ExecStart=/usr/lib/reliaburger/start prepare

[Install]
WantedBy=multi-user.target
