# Spike S3: install /etc/reliaburger from the reliaburger.seed credential,
# a tarball of node.toml, master.key, identity/ and, on the first node,
# security-bootstrap.json. The lab passes it with QEMU's -smbios type=11 (or
# fw_cfg). It runs once, while node.toml is absent. The claim flow replaces
# this in Phase 2 (research §4.2).
[Unit]
Description=Reliaburger spike seed
Before=reliaburger.service
ConditionPathExists=!/etc/reliaburger/node.toml
ConditionCredential=reliaburger.seed

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=reliaburger.seed
StandardOutput=journal+console
ExecStart=/usr/lib/reliaburger/apply-seed

[Install]
WantedBy=multi-user.target
