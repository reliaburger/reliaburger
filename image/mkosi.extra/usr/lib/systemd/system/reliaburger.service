# bun on the appliance. The same restart and kill policy as the quickstart's
# unit (src/relish/quickstart/provision.rs): owners outlive bun restarts.
# bun runs standalone on loopback until a seed (spike S3,
# reliaburger-seed.service) installs a cluster config; appliance mode (claim,
# seed) replaces this in Phase 1.
[Unit]
Description=Reliaburger node
After=network-online.target reliaburger-seed.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/sh -ec 'mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf'
ExecStart=/usr/lib/reliaburger/start
Restart=always
RestartSec=2
LimitNOFILE=1048576
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
