#!/bin/sh
# Wait for bun's liveness endpoint, then say so on the console. Exits
# non-zero (and says why) if bun never answers.
#
# This is also the A/B health gate (research §7.6): the unit runs before
# boot-complete.target, so systemd-bless-boot only marks a freshly updated
# UKI good once bun is healthy. On a counted boot a failure reboots, and
# after three tries systemd-boot falls back to the previous UKI and slot.
#
# A machine with no seed doesn't start bun: `bun appliance prepare` waits
# for a claim (W5) and serves the claim API meanwhile. That counts as
# healthy too, since it's bun answering.
set -u
. /usr/lib/os-release
# BOOT_CHECK_EFIVARS is for image/tests/test_boot_check.py; the unit unsets
# it (UnsetEnvironment=), so the manager's environment can't supply it.
efivars=${BOOT_CHECK_EFIVARS:-/sys/firmware/efi/efivars}
# Seconds since boot, which only move forward. `date +%s` jumps when the
# clock first syncs, and a machine with a flat RTC battery boots hours or
# days behind: the whole budget would pass at that jump, and a counted boot
# of a good update would reboot and fall back. BOOT_CHECK_UPTIME is for the
# tests, and the unit unsets it too.
# Where reliaburger-netlog leaves its runtime drop-ins, and the kernel log.
# BOOT_CHECK_RUN and BOOT_CHECK_KMSG are for the tests; the unit unsets them.
run=${BOOT_CHECK_RUN:-/run}
kmsg=${BOOT_CHECK_KMSG:-/dev/kmsg}
# Whether this boot streams its logs (#2149). reliaburger-netlog gives the
# boot units StandardOutput=kmsg through a runtime drop-in, but this check
# doesn't wait for the network (#2245), so it's already running by then and
# keeps the console it started with. Once the drop-in is there, it writes
# to the kernel log itself: netconsole sends each line, and the kernel puts
# it on the screen once (netlog lets info lines through).
streaming() {
    [ -e "$run/systemd/system/reliaburger-boot-check.service.d/50-netlog.conf" ] && [ -w "$kmsg" ]
}
emit() {
    if streaming; then
        while IFS= read -r line; do
            printf '<6>reliaburger-boot-check: %s\n' "$line" >>"$kmsg"
        done
    else
        cat
    fi
}
say() {
    printf '%s\n' "$*" | emit
}
uptime_seconds() {
    read -r up _ < "${BOOT_CHECK_UPTIME:-/proc/uptime}"
    echo "${up%.*}"
}
counted() {
    # systemd-boot sets this only when the entry has tries left (+N).
    [ -e "$efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f" ]
}
report() {
    say "reliaburger: $1 on OS ${IMAGE_VERSION:-unknown}"
    {
        # The layout, so a boot test log shows the slots and the data partition.
        lsblk -o NAME,SIZE,FSTYPE,PARTLABEL,MOUNTPOINTS 2>/dev/null | sed 's/^/reliaburger: disk: /'
        ip -4 -br addr show scope global 2>/dev/null | sed 's/^/reliaburger: address: /'
        findmnt -n -o TARGET,SOURCE,FSTYPE,OPTIONS / /usr 2>/dev/null | sed 's/^/reliaburger: mount: /'
        journalctl -b -o cat --no-pager -u systemd-repart.service -u systemd-growfs-root.service 2>/dev/null \
            | tail -n 40 | sed 's/^/reliaburger: journal: /'
        # systemd breaks an ordering cycle by dropping jobs (a mount, say),
        # and says so only in the journal; the CI boot test fails on this line.
        journalctl -b -o cat --no-pager 2>/dev/null | grep "Found ordering cycle" \
            | sed 's/^/reliaburger: ordering cycle: /'
    } | emit
    exit 0
}
# Whether prepare still has to finish: not yet started or running
# (enrolling, which can wait for the cluster's first node, or waiting for a
# claim). Until it finishes bun hasn't started, so the clock below doesn't
# either. A node with its config skips prepare altogether.
preparing() {
    [ -f /etc/reliaburger/node.toml ] && return 1
    systemctl is-active -q reliaburger.service && return 1
    case "$(systemctl show -P ActiveState reliaburger-seed.service 2>/dev/null)" in
        active | failed) return 1 ;;
    esac
}
while preparing; do
    if curl -fsSk --max-time 2 https://127.0.0.1:9119/v1/claim >/dev/null 2>&1; then
        report "unclaimed, answering claims on port 9119"
    fi
    sleep 2
done
# A counted boot is a new version on trial. It must have bun healthy and an
# IPv4 address within 150 s of the kernel starting, or it reboots, and after
# its two tries systemd-boot falls back (10-uki.transfer). From the kernel's
# start, not this check's: the check doesn't wait for the network, so a
# version whose network never comes up still fails in time, and the address
# means one that breaks the network falls back rather than stranding the
# node (#2245). On a Wyse 3040 the slowest healthy boot is about 134 s (the
# network about 66 s in, the 30 s clock wait, bun's 38 s), and two tries
# fall back in about 8 min 20 s, inside S5's 10 (#2143). Other boots get 300
# s from here and need no address, since nothing falls back from them, and
# their clock starts only once prepare has finished. test_fallback_limit.py
# and test_time_wait.py read this line, so keep it one line.
if counted; then limit=150; else limit=300; fi
if counted; then deadline=$limit; else deadline=$(( $(uptime_seconds) + limit )); fi
has_address() {
    [ -n "$(ip -4 -o addr show scope global 2>/dev/null)" ]
}
bun_healthy() {
    curl -fsS --max-time 2 http://127.0.0.1:9117/v1/health >/dev/null 2>&1 \
        || curl -fsSk --max-time 2 https://127.0.0.1:9117/v1/health >/dev/null 2>&1
}
missing="bun not healthy"
# At least one look, even when a slow boot reaches the check late.
looked=
while [ -z "$looked" ] || [ "$(uptime_seconds)" -lt "$deadline" ]; do
    looked=1
    if bun_healthy; then
        if ! counted || has_address; then
            report "bun healthy ($(/var/lib/reliaburger/bin/bun --version 2>/dev/null))"
        fi
        missing="no IPv4 address"
    else
        missing="bun not healthy"
    fi
    sleep 2
done
say "reliaburger: $missing after $limit s on OS ${IMAGE_VERSION:-unknown}"
# Why: bun's stderr is in the journal, and a CI boot test keeps only the
# console.
journalctl -b -o cat --no-pager -u reliaburger.service 2>/dev/null \
    | tail -n 60 | sed 's/^/reliaburger: bun: /' | emit
if [ "$missing" = "no IPv4 address" ]; then
    ip -br link 2>/dev/null | sed 's/^/reliaburger: link: /' | emit
fi
if counted; then
    say "reliaburger: counted boot failed, rebooting (systemd-boot falls back after the last try)"
    systemctl reboot
fi
exit 1
