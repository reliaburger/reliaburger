#!/usr/bin/python3
# Unwrap Ubuntu's arm64 kernel before mkosi builds the UKI.
#
# On 26.04 arm64, linux-image's vmlinuz is Canonical's stubble: an EFI stub
# that picks a devicetree (.dtbauto) and then starts the real kernel, an EFI
# zboot image, from its own .linux section. mkosi embeds the whole stubble
# binary as the UKI's .linux, and systemd-stub then refuses it: "Inner kernel
# image contains base relocations, which we do not support." The zboot image
# inside has no relocations, so the UKI gets that instead.
#
# We lose stubble's devicetree matching, which only DT-only arm64 laptops
# need. QEMU's virt machine and the Mac lab hand the kernel its devicetree
# or ACPI tables through the firmware.
#
# A postinst script, not a finalize one: for Format=uki (the installer) mkosi
# saves the kernel aside before the finalize scripts run. It runs in the tools
# tree, before mkosi copies /boot/vmlinuz-<kver> to /usr/lib/modules/<kver>,
# so it handles both places. x86-64 kernels have no .linux section and are
# left alone.

import os
from pathlib import Path

import pefile

root = Path(os.environ["BUILDROOT"])

for kimg in sorted([*root.glob("boot/vmlinuz-*"), *root.glob("usr/lib/modules/*/vmlinuz")]):
    if kimg.is_symlink():
        continue
    pe = pefile.PE(str(kimg), fast_load=True)
    inner = next((s for s in pe.sections if s.Name.rstrip(b"\0") == b".linux"), None)
    if inner is None:
        continue
    # Misc_VirtualSize is the payload; SizeOfRawData is padded to the file
    # alignment.
    data = inner.get_data()[: inner.Misc_VirtualSize]
    pe.close()
    if not data.startswith(b"MZ"):
        raise SystemExit(f"{kimg}: .linux is not a PE kernel image")
    kimg.unlink()
    kimg.write_bytes(data)
    print(f"Unwrapped {kimg.relative_to(root)}: {len(data)} bytes from .linux")
