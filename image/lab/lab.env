# Shared settings for the netboot lab (image/lab/README.md). Source me.
#
# The shared L2 segment is a QEMU hub inside the server VM's QEMU process
# (hubid 0): the server's "lan" NIC plus one unix-socket stream port per
# client slot (work/sock/l2-<n>.sock). Rootless. UDP multicast
# ("-netdev dgram") doesn't work on macOS: QEMU binds the group address and
# macOS then fails every sendto() with EADDRNOTAVAIL.
LAB="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
WORK="$LAB/work"
Q="$(brew --prefix)/share/qemu"
SLOTS="${SLOTS:-40}"
SSH_PORT="${SSH_PORT:-2222}"
mkdir -p "$WORK"
# The lab's SSH key: made on first use, never committed. It reaches the
# server through cloud-init and the nodes through an SMBIOS credential.
[ -f "$WORK/l2lab_key" ] || ssh-keygen -q -t ed25519 -N '' -C l2lab -f "$WORK/l2lab_key"
# ssh -F work/ssh_config l2lab-server, or root@192.168.105.x (jumps via the server).
cat > "$WORK/ssh_config" <<CONF
Host *
  IdentityFile $WORK/l2lab_key
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
Host l2lab-server
  User lab
  HostName 127.0.0.1
  Port $SSH_PORT
Host 192.168.105.*
  ProxyJump l2lab-server
CONF
SSH="ssh -F $WORK/ssh_config l2lab-server"
