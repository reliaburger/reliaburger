# Generated by scripts/release/homebrew.py in @REPOSITORY@ from the
# candidate.json that @TAG@ published, after promote.yml checked it against
# the qualified digest. Edit scripts/release/relish.rb.in there, not this file.
class Relish < Formula
  desc "CLI for Reliaburger, a batteries-included container orchestrator"
  homepage "https://reliaburger.com"
  version "@VERSION@"
  license "Apache-2.0"
@BOTTLE@

  on_macos do
    # Apple silicon only: 0.2.1 was the last Intel macOS build.
    depends_on arch: :arm64

    url "https://github.com/@REPOSITORY@/releases/download/@TAG@/relish-macos-aarch64"
    sha256 "@MACOS_AARCH64@"
  end

  on_linux do
    on_arm do
      url "https://github.com/@REPOSITORY@/releases/download/@TAG@/relish-linux-aarch64"
      sha256 "@LINUX_AARCH64@"
    end
    on_intel do
      url "https://github.com/@REPOSITORY@/releases/download/@TAG@/relish-linux-x86_64"
      sha256 "@LINUX_X86_64@"
    end
  end

  def install
    # The release asset is the bare binary, named for its platform.
    bin.install Dir["relish-*"].fetch(0) => "relish"
  end

  def caveats
    <<~EOS
      Homebrew manages only this CLI: `brew upgrade relish` updates it.
      Upgrade a cluster's nodes with `relish upgrade`, as before.
      `relish uninstall` leaves this copy; `brew uninstall relish` removes it.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/relish --version")
  end
end
