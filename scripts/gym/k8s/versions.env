# What the Kubernetes side of the comparison (#1679) runs, pinned. lab.sh
# reads this file and checks each download; the comparison record and page
# quote it. Re-check every pin on the day of the real runs, and record the
# date: these are the versions current on 6 November 2026.
#
# k3s: https://github.com/k3s-io/k3s/releases/tag/v1.37.2%2Bk3s1
K3S_VERSION=v1.37.2+k3s1
# kubectl on the host, the same minor as the cluster:
# https://kubernetes.io/releases/download/
KUBECTL_VERSION=v1.37.2
# Lima, the release the release harness already uses:
# https://github.com/lima-vm/lima/releases/tag/v2.2.1
LIMA_VERSION=2.2.1
# The workload image every scenario's manifests use, imported into each node
# before a run so nothing waits on a pull: https://hub.docker.com/_/busybox
GYM_IMAGE=docker.io/library/busybox:1.37.0
# The MCP server Claude Code gets on Kubernetes:
# https://github.com/containers/kubernetes-mcp-server/releases/tag/v0.1.2
KUBERNETES_MCP_SERVER_VERSION=0.1.2
# https://github.com/GoogleCloudPlatform/kubectl-ai/releases/tag/v0.0.31
KUBECTL_AI_VERSION=0.0.31
# https://github.com/HolmesGPT/holmesgpt/releases/tag/0.46.0
HOLMESGPT_VERSION=0.46.0
# The Reliaburger side runs the published release.
RELIABURGER_VERSION=0.2.7
