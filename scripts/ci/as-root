#!/usr/bin/env bash
# Run a command as root with the caller's whole environment (#1559).
#
# `sudo -E` keeps the environment on Ubuntu 24.04's sudo, but 26.04's default
# sudo-rs ignores -E ("preserving the entire environment is not supported"),
# so a root step lost CARGO_HOME, RUSTUP_HOME and the job's variables. Both
# sudos run `env NAME=value ... COMMAND` the same way, so hand every variable
# to env as an argument instead.
#
# Usage: scripts/ci/as-root COMMAND [ARGS...]
set -euo pipefail
if [ $# -eq 0 ]; then
    echo "usage: as-root COMMAND [ARGS...]" >&2
    exit 2
fi
variables=()
while IFS= read -r -d '' variable; do
    variables+=("$variable")
done < <(env -0)
exec sudo env -- "${variables[@]}" "$@"
