---
source: src/relish/commands.rs
expression: "json(&InitReport\n{\n    cluster: \"prod\".to_string(), node: \"node-01\".to_string(), node_config:\n    PathBuf::from(\"/etc/reliaburger/reliaburger.toml\"), app_config:\n    PathBuf::from(\"/etc/reliaburger/app.toml\"), master_key:\n    PathBuf::from(\"/etc/reliaburger/prod-master.key\"), security_bootstrap:\n    PathBuf::from(\"/etc/reliaburger/prod-security-bootstrap.json\"),\n    identity_dir: PathBuf::from(\"/etc/reliaburger/identity\"), root_backup:\n    PathBuf::from(\"/media/usb/prod-root-backup.age\"), root_ca_fingerprint:\n    \"sha256:ab12\".to_string(), development_plaintext: false,\n})"
---
{
  "cluster": "prod",
  "node": "node-01",
  "node_config": "/etc/reliaburger/reliaburger.toml",
  "app_config": "/etc/reliaburger/app.toml",
  "master_key": "/etc/reliaburger/prod-master.key",
  "security_bootstrap": "/etc/reliaburger/prod-security-bootstrap.json",
  "identity_dir": "/etc/reliaburger/identity",
