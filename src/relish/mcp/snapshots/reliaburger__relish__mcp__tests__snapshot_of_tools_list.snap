[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "relish agent version"
    },
    "description": "This binary's version, commit, target and cluster formats",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 24576,
          "description": "Largest answer to print, in bytes (at least 1024). A bigger answer is trimmed, marked `truncated`, and says how to get the rest",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "version",
    "outputSchema": {
      "description": "The relish.agent/v1 envelope. `ok` says whether the command answered: then `data` is the answer, otherwise `error` says why not.",
      "properties": {
        "command": {
          "type": "string"
        },
        "data": "<relish agent version data schema>",
        "error": {
          "description": "Why the command couldn't answer: code, message, endpoint, status, hint.",
          "type": "object"
        },
        "next": {
          "description": "Commands worth running next, each with run, why and read_only.",
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "relish": {
          "description": "The build of relish that answered.",
          "type": "object"
        },
        "schema": {
          "const": "relish.agent/v1"
        },
        "truncated": {
          "description": "The answer was trimmed to fit max_bytes; a warning says what was cut.",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "command",
        "ok",
        "relish"
      ],
      "type": "object"
    },
    "title": "relish agent version"
  },
