---
source: src/relish/agent/guide.rs
expression: "artefact(paths::MCPB_MANIFEST)"
---
{
  "author": {
    "name": "Miko Pawlikowski",
    "url": "https://reliaburger.com"
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "linux"
    ]
  },
  "description": "Read-only Reliaburger cluster diagnosis: the relish agent commands as MCP tools.",
  "display_name": "Reliaburger relish",
  "documentation": "https://github.com/reliaburger/reliaburger/blob/v0.2.7/docs/manual/16_working-with-an-ai-agent.md",
  "homepage": "https://reliaburger.com/agents",
  "keywords": [
    "reliaburger",
    "relish",
    "orchestrator",
    "containers",
    "sre"
  ],
  "license": "Apache-2.0",
  "manifest_version": "0.3",
  "name": "relish",
  "repository": {
    "type": "git",
    "url": "https://github.com/reliaburger/reliaburger"
  },
  "server": {
    "entry_point": "server/relish",
    "mcp_config": {
      "args": [
        "mcp"
      ],
      "command": "${__dirname}/server/relish",
      "env": {
        "RELIABURGER_ENDPOINT": "${user_config.endpoint}",
        "RELIABURGER_TOKEN": "${user_config.token}"
      }
    },
    "type": "binary"
  },
  "support": "https://github.com/reliaburger/reliaburger/issues",
  "tools": [
    {
      "description": "This chapter, as Markdown sections.",
      "name": "guide"
    },
    {
      "description": "Search it | quickly.",
      "name": "source_grep"
    }
  ],
  "user_config": {
    "endpoint": {
      "default": "",
      "description": "The Bun API address, such as https://10.0.0.5:9117. Leave it empty to use relish's current context.",
      "required": false,
      "title": "Cluster API endpoint (optional)",
      "type": "string"
    },
    "token": {
      "default": "",
      "description": "A read-only token, made with `relish token create --name agent --role read-only --ttl-days 1`: https://github.com/reliaburger/reliaburger/blob/main/docs/manual/16_working-with-an-ai-agent.md#a-read-only-token. Leave it empty to use relish's current context.",
      "required": false,
      "sensitive": true,
      "title": "Read-only API token (optional)",
      "type": "string"
    }
  },
  "version": "0.2.7"
}
